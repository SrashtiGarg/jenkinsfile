pipeline {
    agent any

    stages {
        stage('Git-Clone') {
            steps {
                git branch: 'main', credentialsId: 'ubuntu-ec2-key', url: 'https://github.com/cloud-blitz/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                sh '''cd backend
                    mvn clean package -Dskiptests'''
            }
        }
    }
}
