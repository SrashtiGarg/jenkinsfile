pipeline {
    agent any

    stages {
        stage('Git-Clone') {
            steps {
                git branch: 'main', credentialsId: 'ubuntu-ec2-key', url: 'https://github.com/cloud-blitz/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                sh '''cd backend
                    mvn clean package -DskipTests'''
            }
        }
        stage('Test') {
            steps {
                withSonarQubeEnv(installationName: 'MySonarInst' , credentialsId: 'MyId') {
                    sh '''
                    cd backend
                    mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \\
                      -Dsonar.projectKey=MyFirstProject \\
                      -Dsonar.projectName=\'MyFirstProject\''''
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(10) {
                    waitForQualityGate abortPipeline: true, credentialsId: 'MyId'
                }
            }
        }
    }
}
